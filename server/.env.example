# Copie para .env e preencha
# PostgreSQL (recomendado — VPS Hostinger, Neon, Supabase…)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/vitalis?schema=public"

# MySQL (alternativa na Hostinger compartilhada — troque o provider no schema.prisma)
# DATABASE_URL="mysql://usuario:senha@localhost:3306/vitalis"

# Segredo do token JWT — gere com: openssl rand -hex 32
JWT_SECRET="gere-um-segredo-longo-e-aleatorio"

# Porta da API (o Nginx faz o proxy 443 → esta porta)
PORT=8787
